# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development. NEVER commit a real .env file.
#   cp .env.example .env.local
# `.env*` is gitignored (except this file) — see .gitignore.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase PostgreSQL. Supabase Project Settings -> Database -> Connection
# string -> URI (use the *session* pooler for runtime, *direct* for migrations).
# Password must be URL-encoded if it contains special characters.
#
# NOTE: `prisma migrate` needs the DIRECT connection (port 5432).
# Serverless runtime should use the pooler (port 6543) + ?pgbouncer=true
# or ?connection_limit=1. That switch belongs in a later step, not now.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?schema=public"

# --- Auth (Auth.js / NextAuth v5) -----------------------------------------
# Used to encrypt session cookies. MUST be set in every deployed environment.
# Generate a fresh value:  npx auth secret
# (or: openssl rand -base64 32)
AUTH_SECRET=""

# Canonical public URL, used for callback/redirect construction.
# No trailing slash.
AUTH_URL="http://localhost:3000"

# --- Admin bootstrap (optional, local/dev only) ---------------------------
# Read by a seed script to create the first admin account.
# Not read by application code at runtime. The password is hashed on insert and
# this variable can be removed once the account exists.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# --- Future payments ------------------------------------------------------
# Intentionally NOT configured. No payment provider is integrated.
# When one is added, keep provider secrets server-only (never NEXT_PUBLIC_*).
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# EASYPAISA_STORE_ID=""
# EASYPAISA_HASH_KEY=""
# JAZZCASH_WEBHOOK_SECRET=""